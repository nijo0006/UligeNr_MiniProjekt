            <column caption='Rating' datatype='string' name='[RatingLabel]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ISNULL([meanRating]) THEN &quot;No data&quot; ELSE STR(ROUND([meanRating], 1)) + &quot; / 5&quot; END' />
