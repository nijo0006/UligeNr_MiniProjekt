{
  "openapi": "3.0.3",
  "info": {
    "title": "Hotel Kong Arthur Operations API",
    "version": "0.4.0",
    "description": "Guest booking and staff hotel/bar operations, including reconciled Excel history with labelled generated dates/room assignments across 2024–2026. Original source values are preserved independently of operational edits. Other hotel reports, satisfaction and Tableau remain pending. Local prototype without login."
  },
  "servers": [
    {
      "url": "http://localhost:3000"
    }
  ],
  "security": [],
  "paths": {
    "/api/health": {
      "get": {
        "operationId": "health",
        "summary": "Read application readiness",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ready"
                      ]
                    }
                  },
                  "required": [
                    "status"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "503": {
            "description": "Database/initialization unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/catalog": {
      "get": {
        "operationId": "catalog",
        "summary": "Read approved types, countries, seasonal tariffs, and category names",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Catalog"
                }
              }
            }
          }
        }
      }
    },
    "/api/rooms": {
      "get": {
        "operationId": "rooms",
        "summary": "List inventory or rooms available for an interval",
        "parameters": [
          {
            "name": "arrival",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "departure",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "roomType",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "excludeBookingId",
            "in": "query",
            "required": false,
            "description": "Exclude this booking itself when showing availability for an edit.",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Room"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input or attempted override of read-only calculations",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "description": "Supply arrival and departure together for availability filtering. Arrival inclusive, departure exclusive. Inventory is labelled synthetic. Do not enforce guest capacity."
      }
    },
    "/api/bookings": {
      "get": {
        "operationId": "bookings",
        "summary": "List active bookings",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Booking"
                  }
                }
              }
            }
          }
        },
        "description": "Cancelled bookings do not appear in the active list. No login required."
      },
      "post": {
        "operationId": "createBooking",
        "summary": "Create a booking with generated ID and price",
        "parameters": [],
        "responses": {
          "201": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Booking"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input or attempted override of read-only calculations",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Stale edit: reload; or room unavailable; no partial mutation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BookingCreate"
              }
            }
          }
        },
        "description": "Create one booking with selected rooms; derive departure and nightly prices; atomically check availability. No request-idempotency-key or duplicate-specific save rule. Clients cannot supply ID, total price, departure, or nightly charges."
      }
    },
    "/api/bookings/{bookingId}": {
      "get": {
        "operationId": "booking",
        "summary": "Read a known active or cancelled booking",
        "parameters": [
          {
            "name": "bookingId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Booking"
                }
              }
            }
          },
          "404": {
            "description": "Booking not found; no mutation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "put": {
        "operationId": "editBooking",
        "summary": "Edit permitted fields using the saved version",
        "parameters": [
          {
            "name": "bookingId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Booking"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input or attempted override of read-only calculations",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Booking not found; no mutation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Stale edit: reload; or room unavailable; no partial mutation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BookingEdit"
              }
            }
          }
        },
        "description": "Preserve immutable ID. Compare version atomically; stale state returns conflict and a reload message. Recalculate prices and departure; check availability again. Cancelled-booking editing/reactivation is not established by this draft."
      },
      "delete": {
        "operationId": "cancelBooking",
        "summary": "Cancel a known booking",
        "parameters": [
          {
            "name": "bookingId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Booking"
                }
              }
            }
          },
          "404": {
            "description": "Booking not found; no mutation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "description": "Known cancelled ID remains cancelled without changing reports again. Browser asks for confirmation before sending. Unknown ID reports Booking not found. Storage retains enough lifecycle information to distinguish the two."
      }
    },
    "/api/reports/revenue": {
      "get": {
        "operationId": "annualRoomRevenue",
        "summary": "Read booked room revenue for a calendar year",
        "description": "Sum each active booking room-night charge by the calendar year of that night. Arrival included, departure excluded. Includes future stays in the selected year. Cancelled bookings are excluded. Returns null without eligible nights; preserves an actual zero as 0.00. DKK amounts are exact decimal strings, displayed to one decimal in the frontend. Imported history uses its original recorded nightly prices, not the current tariff. Generated dates are labelled with containsSyntheticData; see /api/reports/history. Bar revenue is not included. Reads current saved data on every request.",
        "parameters": [
          {
            "name": "year",
            "in": "query",
            "required": true,
            "description": "One four-digit calendar year, within the existing booking API date range.",
            "schema": {
              "type": "integer",
              "minimum": 1000,
              "maximum": 9999
            },
            "example": 2026
          }
        ],
        "responses": {
          "200": {
            "description": "Annual room revenue; no-data amount is null.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnnualRoomRevenue"
                },
                "examples": {
                  "withData": {
                    "value": {
                      "year": 2026,
                      "currency": "DKK",
                      "roomRevenue": "2491.00",
                      "containsSyntheticData": false
                    }
                  },
                  "withoutData": {
                    "value": {
                      "year": 2024,
                      "currency": "DKK",
                      "roomRevenue": null,
                      "containsSyntheticData": false
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Missing, repeated or invalid year",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Database temporarily unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/drinks": {
      "get": {
        "operationId": "drinkCatalog",
        "summary": "Read the source drink menu with fixed prices",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Drink"
                  }
                }
              }
            }
          },
          "503": {
            "description": "Database temporarily unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/bar-sales": {
      "get": {
        "operationId": "dailyBarSales",
        "summary": "Read effective quantities for one sales date",
        "parameters": [
          {
            "name": "date",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DailyBarSales"
                }
              }
            }
          },
          "400": {
            "description": "Invalid date, drink, quantity or reporting year",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Database temporarily unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/bar-sales/{salesDate}/{drinkId}": {
      "put": {
        "operationId": "replaceDailyBarQuantity",
        "summary": "Save or correct one daily drink quantity",
        "description": "No booking is required. One effective quantity per sales date and drink. Corrections replace, never add. Preserve the first recorded unit-price snapshot; manual prices are rejected. Non-negative whole quantities use extendable selection controls; the maximum is a storage boundary, not a business limit.",
        "parameters": [
          {
            "name": "salesDate",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "drinkId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "quantity"
                ],
                "properties": {
                  "quantity": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 4294967295
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SavedBarSale"
                }
              }
            }
          },
          "400": {
            "description": "Invalid date, drink, quantity or reporting year",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Database temporarily unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/reports/bar": {
      "get": {
        "operationId": "annualBarReport",
        "summary": "Read annual bar revenue, units, category mix and revenue per drink",
        "description": "Only dated daily sales are included. Source aggregates are allocated to labelled synthetic daily records across 2024–2026. Only the generated daily records contribute to revenue; raw aggregates are not counted a second time. containsSyntheticData identifies these results. Wine/beer contribute to overall totals, but not the cocktail/coffee denominator. No-data values are null. For recorded zero comparison revenue, mixStatus is undefined: no numeric percentage is invented and the outstanding zero-denominator clarification is not marked resolved. Exact DKK strings; frontend displays one decimal.",
        "parameters": [
          {
            "name": "year",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1000,
              "maximum": 9999
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnnualBarReport"
                }
              }
            }
          },
          "400": {
            "description": "Invalid date, drink, quantity or reporting year",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Database temporarily unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/reports/history": {
      "get": {
        "operationId": "historicalImportStatus",
        "summary": "Read original Excel control totals and demonstration-year allocation",
        "description": "Immutable original source totals across the complete source horizon. They are reference values, not additional reportable revenue or claimed actual annual history. Operational edits/cancellations affect current reporting without changing this evidence. Dates/assignments are generated; missing person counts remain unknown.",
        "responses": {
          "200": {
            "description": "Import status and immutable reference totals if imported",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HistoryStatus"
                }
              }
            }
          },
          "503": {
            "description": "Database unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "details": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "required": [
          "code",
          "message"
        ],
        "additionalProperties": false
      },
      "GuestName": {
        "type": "object",
        "properties": {
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          }
        },
        "required": [
          "firstName",
          "lastName"
        ],
        "additionalProperties": false
      },
      "BookingCreate": {
        "type": "object",
        "properties": {
          "holderFirstName": {
            "type": "string"
          },
          "holderLastName": {
            "type": "string"
          },
          "holderCountry": {
            "type": "string"
          },
          "guestCount": {
            "type": "integer",
            "minimum": 1,
            "description": "Recorded person count including holder; no per-room capacity policy."
          },
          "guests": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GuestName"
            }
          },
          "roomNumbers": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "arrival": {
            "type": "string",
            "format": "date"
          },
          "nights": {
            "type": "integer",
            "minimum": 1,
            "description": "Positive whole nights; no arbitrary maximum is selected. Final frontend choices remain spec R3."
          }
        },
        "required": [
          "holderFirstName",
          "holderLastName",
          "holderCountry",
          "guestCount",
          "roomNumbers",
          "arrival",
          "nights"
        ],
        "additionalProperties": false
      },
      "BookingEdit": {
        "type": "object",
        "properties": {
          "holderFirstName": {
            "type": "string"
          },
          "holderLastName": {
            "type": "string"
          },
          "holderCountry": {
            "type": "string"
          },
          "guestCount": {
            "type": "integer",
            "minimum": 1,
            "description": "Null may be retained only for an imported booking whose person count is unknown; no missing guests are invented.",
            "nullable": true
          },
          "guests": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GuestName"
            }
          },
          "roomNumbers": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "arrival": {
            "type": "string",
            "format": "date"
          },
          "nights": {
            "type": "integer",
            "minimum": 1,
            "description": "Positive whole nights; no arbitrary maximum is selected. Final frontend choices remain spec R3."
          },
          "version": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "holderFirstName",
          "holderLastName",
          "holderCountry",
          "guestCount",
          "roomNumbers",
          "arrival",
          "nights",
          "version"
        ],
        "additionalProperties": false
      },
      "Room": {
        "type": "object",
        "properties": {
          "roomNumber": {
            "type": "string"
          },
          "roomType": {
            "type": "string"
          },
          "synthetic": {
            "type": "boolean"
          }
        },
        "required": [
          "roomNumber",
          "roomType",
          "synthetic"
        ],
        "additionalProperties": false
      },
      "NightCharge": {
        "type": "object",
        "properties": {
          "roomNumber": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "season": {
            "type": "string",
            "enum": [
              "low",
              "mid",
              "high"
            ]
          },
          "charge": {
            "type": "string",
            "pattern": "^-?[0-9]+\\.[0-9]{2}$",
            "description": "Exact DKK amount encoded as a decimal string. Format one decimal in the user-facing view; source reconciliation retains full precision.",
            "example": "2491.00"
          }
        },
        "required": [
          "roomNumber",
          "date",
          "season",
          "charge"
        ],
        "additionalProperties": false
      },
      "Booking": {
        "type": "object",
        "properties": {
          "holderFirstName": {
            "type": "string"
          },
          "holderLastName": {
            "type": "string"
          },
          "holderCountry": {
            "type": "string"
          },
          "guestCount": {
            "type": "integer",
            "nullable": true,
            "description": "Null when source records do not establish person count."
          },
          "guests": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GuestName"
            }
          },
          "roomNumbers": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "arrival": {
            "type": "string",
            "format": "date"
          },
          "nights": {
            "type": "integer",
            "minimum": 1,
            "description": "Positive whole nights; no arbitrary maximum is selected. Final frontend choices remain spec R3."
          },
          "bookingId": {
            "type": "integer",
            "minimum": 1
          },
          "departure": {
            "type": "string",
            "format": "date"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "cancelled"
            ]
          },
          "totalPrice": {
            "type": "string",
            "pattern": "^-?[0-9]+\\.[0-9]{2}$",
            "description": "Exact DKK amount encoded as a decimal string. Format one decimal in the user-facing view; source reconciliation retains full precision.",
            "example": "2491.00"
          },
          "nightCharges": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/NightCharge"
            }
          },
          "syntheticDates": {
            "type": "boolean"
          },
          "syntheticRoomAssignment": {
            "type": "boolean"
          },
          "sourceId": {
            "type": "string",
            "nullable": true
          },
          "pricingMode": {
            "type": "string",
            "enum": [
              "nightly-calculated",
              "source-preserved"
            ],
            "description": "Imported bookings retain original source nightly prices; saving an edit applies the current tariff while preserving immutable source evidence."
          }
        },
        "required": [
          "bookingId",
          "holderFirstName",
          "holderLastName",
          "holderCountry",
          "guestCount",
          "roomNumbers",
          "arrival",
          "departure",
          "nights",
          "version",
          "status",
          "totalPrice",
          "syntheticDates",
          "syntheticRoomAssignment",
          "pricingMode"
        ],
        "additionalProperties": false
      },
      "Rate": {
        "type": "object",
        "properties": {
          "roomType": {
            "type": "string"
          },
          "season": {
            "type": "string",
            "enum": [
              "low",
              "mid",
              "high"
            ]
          },
          "nightlyPrice": {
            "type": "string",
            "pattern": "^-?[0-9]+\\.[0-9]{2}$",
            "description": "Exact DKK amount encoded as a decimal string. Format one decimal in the user-facing view; source reconciliation retains full precision.",
