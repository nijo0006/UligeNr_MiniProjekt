{
  "openapi": "3.0.3",
  "info": {
    "title": "Hotel Operations API \u2014 Draft",
    "version": "0.1.0",
    "description": "Independent planning contract only. No endpoints are implemented. Tableau transport is deferred. Open business items are in research.md and spec.md; no duplicate-creation handling or login is added."
  },
  "servers": [
    {
      "url": "http://localhost:3000"
    }
  ],
  "security": [],
  "paths": {
    "/api/health": {
      "get": {
        "operationId": "health",
        "summary": "Read application readiness",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ready"
                      ]
                    }
                  },
                  "required": [
                    "status"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "503": {
            "description": "Database/initialization unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/catalog": {
      "get": {
        "operationId": "catalog",
        "summary": "Read approved types, countries, seasonal tariffs, and category names",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Catalog"
                }
              }
            }
          }
        }
      }
    },
    "/api/rooms": {
      "get": {
        "operationId": "rooms",
        "summary": "List inventory or rooms available for an interval",
        "parameters": [
          {
            "name": "arrival",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "departure",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "roomType",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Room"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input or attempted override of read-only calculations",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "description": "Supply arrival and departure together for availability filtering. Arrival inclusive, departure exclusive. Inventory is labelled synthetic. Do not enforce guest capacity."
      }
    },
    "/api/bookings": {
      "get": {
        "operationId": "bookings",
        "summary": "List active bookings",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Booking"
                  }
                }
              }
            }
          }
        },
        "description": "Cancelled bookings do not appear in the active list. No login required."
      },
      "post": {
        "operationId": "createBooking",
        "summary": "Create a booking with generated ID and price",
        "parameters": [],
        "responses": {
          "201": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Booking"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input or attempted override of read-only calculations",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Stale edit: reload; or room unavailable; no partial mutation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BookingCreate"
              }
            }
          }
        },
        "description": "Create one booking with selected rooms; derive departure and nightly prices; atomically check availability. No request-idempotency-key or duplicate-specific save rule. Clients cannot supply ID, total price, departure, or nightly charges."
      }
    },
    "/api/bookings/{bookingId}": {
      "get": {
        "operationId": "booking",
        "summary": "Read a known active or cancelled booking",
        "parameters": [
          {
            "name": "bookingId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Booking"
                }
              }
            }
          },
          "404": {
            "description": "Booking not found; no mutation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "put": {
        "operationId": "editBooking",
        "summary": "Edit permitted fields using the saved version",
        "parameters": [
          {
            "name": "bookingId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Booking"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input or attempted override of read-only calculations",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Booking not found; no mutation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Stale edit: reload; or room unavailable; no partial mutation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BookingEdit"
              }
            }
          }
        },
        "description": "Preserve immutable ID. Compare version atomically; stale state returns conflict and a reload message. Recalculate prices and departure; check availability again. Cancelled-booking editing/reactivation is not established by this draft."
      },
      "delete": {
        "operationId": "cancelBooking",
        "summary": "Cancel a known booking",
        "parameters": [
          {
            "name": "bookingId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Booking"
                }
              }
            }
          },
          "404": {
            "description": "Booking not found; no mutation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "description": "Known cancelled ID remains cancelled without changing reports again. Browser asks for confirmation before sending. Unknown ID reports Booking not found. Storage retains enough lifecycle information to distinguish the two."
      }
    },
    "/api/drinks": {
      "get": {
        "operationId": "drinks",
        "summary": "Read supplied drink catalog; do not invent wine/beer menu entries",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Drink"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/bar-sales": {
      "get": {
        "operationId": "barSales",
        "summary": "Read dated daily bar quantities",
        "parameters": [
          {
            "name": "year",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "salesDate",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/DailyBarSale"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/bar-sales/{salesDate}/{drinkId}": {
      "put": {
        "operationId": "replaceDailyBarSale",
        "summary": "Record or replace one date/drink quantity",
        "parameters": [
          {
            "name": "salesDate",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "drinkId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DailyBarSale"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input or attempted override of read-only calculations",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Drink not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DailyBarInput"
              }
            }
          }
        },
        "description": "Replace effective quantity rather than incrementing it. Price comes from stored catalog/snapshot, never from request input. No hotel booking is required. Future menu price-change policy remains open."
      }
    },
    "/api/satisfaction": {
      "post": {
        "operationId": "recordSatisfaction",
        "summary": "Record a rating linked to a booking and one of its rooms",
        "parameters": [],
        "responses": {
          "201": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SatisfactionResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input or attempted override of read-only calculations",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Booking not found; no mutation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SatisfactionInput"
              }
            }
          }
        },
        "description": "Receptionist entry, no login; validate 1\u20135 and room belongs to booking. Do not copy the response across all booked rooms. Repeat-response/correction policy is not added here."
      }
    },
    "/api/reports/summary": {
      "get": {
        "operationId": "reportSummary",
        "summary": "Read current totals for the reporting scope",
        "parameters": [
          {
            "name": "year",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Summary"
                }
              }
            }
          }
        },
        "description": "Current saved data on the next request. Optional year filters the calendar year; absent year means whole dataset. Source provenance remains visible. Ranking ties and R10 numeric boundaries are unresolved; this is a draft contract. Annual occupancy uses approved 214 \u00d7 365 denominator; do not present a whole-source 3-year sum as one-year occupancy."
      }
    },
    "/api/reports/countries": {
      "get": {
        "operationId": "reportCountries",
        "summary": "Read holder-country room revenue and distinct booking/person counts",
        "parameters": [
          {
            "name": "year",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CountryReportRow"
                  }
                }
              }
            }
          }
        },
        "description": "Current saved data on the next request. Optional year filters the calendar year; absent year means whole dataset. Source provenance remains visible. Ranking ties and R10 numeric boundaries are unresolved; this is a draft contract. Bar revenue is excluded. Unknown historical person count is null, never relabelled booking count."
      }
    },
    "/api/reports/rooms": {
      "get": {
        "operationId": "reportRooms",
        "summary": "Read room revenue for known assignments",
        "parameters": [
          {
            "name": "year",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/RoomReportRow"
                  }
                }
              }
            }
          }
        },
        "description": "Current saved data on the next request. Optional year filters the calendar year; absent year means whole dataset. Source provenance remains visible. Ranking ties and R10 numeric boundaries are unresolved; this is a draft contract."
      }
    },
    "/api/reports/room-types-seasons": {
      "get": {
        "operationId": "reportRoomTypesSeasons",
        "summary": "Read room-type revenue per season",
        "parameters": [
          {
            "name": "year",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SeasonReportRow"
                  }
                }
              }
            }
          }
        },
        "description": "Current saved data on the next request. Optional year filters the calendar year; absent year means whole dataset. Source provenance remains visible. Ranking ties and R10 numeric boundaries are unresolved; this is a draft contract."
      }
    },
    "/api/reports/drinks": {
      "get": {
        "operationId": "reportDrinks",
        "summary": "Read drink units and revenue",
        "parameters": [
          {
            "name": "year",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/DrinkReportRow"
                  }
                }
              }
            }
          }
        },
        "description": "Current saved data on the next request. Optional year filters the calendar year; absent year means whole dataset. Source provenance remains visible. Ranking ties and R10 numeric boundaries are unresolved; this is a draft contract."
      }
    },
    "/api/reports/satisfaction": {
      "get": {
        "operationId": "reportSatisfaction",
        "summary": "Read per-room satisfaction mean and response count",
        "parameters": [
          {
            "name": "year",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SatisfactionRow"
                  }
                }
              }
            }
          }
        },
        "description": "Current saved data on the next request. Optional year filters the calendar year; absent year means whole dataset. Source provenance remains visible. Ranking ties and R10 numeric boundaries are unresolved; this is a draft contract."
      }
    },
    "/api/reports/inventory": {
      "get": {
        "operationId": "reportInventory",
        "summary": "Count rooms by type independently of bookings",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/InventoryRow"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "details": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "required": [
          "code",
          "message"
        ],
        "additionalProperties": false
      },
      "GuestName": {
        "type": "object",
        "properties": {
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          }
        },
        "required": [
          "firstName",
          "lastName"
        ],
        "additionalProperties": false
      },
      "BookingCreate": {
        "type": "object",
        "properties": {
          "holderFirstName": {
            "type": "string"
          },
          "holderLastName": {
            "type": "string"
          },
          "holderCountry": {
            "type": "string"
          },
          "guestCount": {
            "type": "integer",
            "minimum": 1,
            "description": "Recorded person count including holder; no per-room capacity policy."
          },
          "guests": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GuestName"
            }
          },
          "roomNumbers": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "arrival": {
            "type": "string",
            "format": "date"
          },
          "nights": {
            "type": "integer",
            "minimum": 1,
            "description": "Positive whole nights; no arbitrary maximum is selected. Final frontend choices remain spec R3."
          }
        },
        "required": [
          "holderFirstName",
          "holderLastName",
          "holderCountry",
          "guestCount",
          "roomNumbers",
          "arrival",
          "nights"
        ],
        "additionalProperties": false
      },
      "BookingEdit": {
        "type": "object",
        "properties": {
          "holderFirstName": {
            "type": "string"
          },
          "holderLastName": {
            "type": "string"
          },
          "holderCountry": {
            "type": "string"
          },
          "guestCount": {
            "type": "integer",
            "minimum": 1,
            "description": "Recorded person count including holder; no per-room capacity policy."
          },
          "guests": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GuestName"
            }
          },
          "roomNumbers": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "arrival": {
            "type": "string",
            "format": "date"
          },
          "nights": {
            "type": "integer",
            "minimum": 1,
            "description": "Positive whole nights; no arbitrary maximum is selected. Final frontend choices remain spec R3."
          },
          "version": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "holderFirstName",
          "holderLastName",
          "holderCountry",
          "guestCount",
          "roomNumbers",
          "arrival",
          "nights",
          "version"
        ],
        "additionalProperties": false
      },
      "Room": {
        "type": "object",
        "properties": {
          "roomNumber": {
            "type": "string"
          },
          "roomType": {
            "type": "string"
          },
          "synthetic": {
            "type": "boolean"
          }
        },
        "required": [
          "roomNumber",
          "roomType",
          "synthetic"
        ],
        "additionalProperties": false
      },
      "NightCharge": {
        "type": "object",
        "properties": {
          "roomNumber": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "season": {
            "type": "string",
            "enum": [
              "low",
              "mid",
              "high"
            ]
          },
          "charge": {
            "type": "string",
            "pattern": "^-?[0-9]+\\.[0-9]{2}$",
            "description": "Exact DKK amount encoded as a decimal string. Format one decimal in the user-facing view; source reconciliation retains full precision.",
            "example": "2491.00"
          }
        },
        "required": [
          "roomNumber",
          "date",
          "season",
          "charge"
        ],
        "additionalProperties": false
      },
      "Booking": {
        "type": "object",
        "properties": {
          "holderFirstName": {
            "type": "string"
          },
          "holderLastName": {
            "type": "string"
          },
          "holderCountry": {
            "type": "string"
          },
          "guestCount": {
            "type": "integer",
            "nullable": true,
            "description": "Null when source records do not establish person count."
          },
          "guests": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GuestName"
            }
          },
          "roomNumbers": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "arrival": {
            "type": "string",
            "format": "date"
          },
          "nights": {
            "type": "integer",
            "minimum": 1,
            "description": "Positive whole nights; no arbitrary maximum is selected. Final frontend choices remain spec R3."
          },
          "bookingId": {
            "type": "integer",
            "minimum": 1
          },
          "departure": {
            "type": "string",
            "format": "date"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "cancelled"
            ]
          },
          "totalPrice": {
            "type": "string",
            "pattern": "^-?[0-9]+\\.[0-9]{2}$",
            "description": "Exact DKK amount encoded as a decimal string. Format one decimal in the user-facing view; source reconciliation retains full precision.",
            "example": "2491.00"
          },
          "nightCharges": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/NightCharge"
            }
          },
