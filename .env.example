# Optional local overrides. A fresh clone also starts with the local-only Compose defaults.
# Existing MySQL volumes keep the credentials chosen during their first initialization.
MYSQL_ROOT_PASSWORD=hotel_local_root_password
MYSQL_DATABASE=hotel_kong_arthur
MYSQL_USER=hotel_user
MYSQL_PASSWORD=hotel_local_password
MYSQL_HOST_PORT=3307
APP_PORT=3000
