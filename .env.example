# Optional local overrides; a fresh clone works with the Compose defaults.
# PostgreSQL volumes retain their initial credentials. Legacy MYSQL_* values are unused.
POSTGRES_DB=hotel_kong_arthur
POSTGRES_USER=hotel_user
POSTGRES_PASSWORD=hotel_local_password
POSTGRES_HOST_PORT=5433
APP_PORT=3000
# Questionnaire email (Story 24). Mailpit inbox: http://localhost:8025
MAILPIT_UI_PORT=8025
PUBLIC_BASE_URL=http://localhost:3000
